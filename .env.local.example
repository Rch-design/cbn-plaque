# ===== Appwrite (public - navigateur) =====
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=main
NEXT_PUBLIC_APPWRITE_BUCKET_ID=project-images

# IDs des collections (laisser tels quels si vous utilisez le script de setup)
NEXT_PUBLIC_APPWRITE_COL_SERVICES=services
NEXT_PUBLIC_APPWRITE_COL_PROJECTS=projects
NEXT_PUBLIC_APPWRITE_COL_PROJECT_IMAGES=project_images
NEXT_PUBLIC_APPWRITE_COL_MESSAGES=messages
NEXT_PUBLIC_APPWRITE_COL_SETTINGS=site_settings
NEXT_PUBLIC_APPWRITE_COL_PAGES=pages
NEXT_PUBLIC_APPWRITE_COL_REVIEWS=reviews
NEXT_PUBLIC_APPWRITE_COL_ANALYTICS=analytics
NEXT_PUBLIC_APPWRITE_COL_BANNERS=banners

# ===== Appwrite (serveur - scripts setup; optionnel sur Vercel) =====
# Cle API creee dans la console Appwrite (Overview > Integrate > API Keys)
APPWRITE_API_KEY=

# ===== Compte admin (optionnel - cree automatiquement par le script de setup) =====
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== SEO =====
# Google Search Console (Balise HTML)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxx

# ===== Contact form e-posta (Resend — resend.com) =====
# APPWRITE_API_KEY gerekli (mesaj kaydi + e-posta icin Vercel'de)
# RESEND_API_KEY=re_xxxxxxxx
# Domain dogrulanmadan Resend sadece hesap e-postaniza gonderir (signup email)
# cbnplaque.com dogrulayinca: RESEND_FROM=noreply@cbnplaque.com, CONTACT_NOTIFY_EMAIL=cbnplaque@gmail.com
# CONTACT_NOTIFY_EMAIL=sertaccoban@gmail.com
# RESEND_FROM=onboarding@resend.dev
