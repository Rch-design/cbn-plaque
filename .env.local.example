# ===== Cloudflare D1 (serveur) =====
# Adimlar: CLOUDFLARE-KURULUM.md
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# ===== Cloudflare R2 (serveur) =====
R2_BUCKET=cbn-images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ===== R2 public (navigateur) =====
# Custom domain (recommande) ou https://pub-xxxx.r2.dev
NEXT_PUBLIC_ASSET_BASE_URL=https://assets.cbnplaque.com

# ===== Admin (serveur) =====
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== SEO =====
# Google Search Console (Balise HTML)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxx

# ===== Contact form e-posta (Resend — resend.com) =====
# RESEND_API_KEY=re_xxxxxxxx
# Domain dogrulanmadan Resend sadece hesap e-postaniza gonderir (signup email)
# cbnplaque.com dogrulayinca: RESEND_FROM=noreply@cbnplaque.com, CONTACT_NOTIFY_EMAIL=cbnplaque@gmail.com
# CONTACT_NOTIFY_EMAIL=sertaccoban@gmail.com
# RESEND_FROM=onboarding@resend.dev

# ===== Appwrite (SADECE veri aktarimi icin — aktarim sonrasi silinebilir) =====
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=main
NEXT_PUBLIC_APPWRITE_BUCKET_ID=project-images
APPWRITE_API_KEY=
